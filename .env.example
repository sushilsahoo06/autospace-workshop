# ==========================================
# Root Environment Template (.env.example)
# ==========================================

# PostgreSQL Connection String (Port 2010 for local Docker, or remote cloud connection)
DATABASE_URL="postgresql://postgres:password@localhost:2010/autospace?schema=public"

# NextAuth / Backend JWT Shared Secret (Must match across API and Web portals)
JWT_SECRET="autospace_jwt_shared_secret_key_2024"
NEXTAUTH_SECRET="autospace_jwt_shared_secret_key_2024"

# Service URLs
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3001"

# Third-Party Integrations
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1_your_mapbox_token_here"

