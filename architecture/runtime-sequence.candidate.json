  "cards": [
    {
      "dot": "cyan",
      "title": "Stage 1: Search & 3D Slot Selection",
      "items": [
        "Driver searches location via Mapbox integration in apps/web (:3001)",
        "GraphQL query fetches available parking structures and slots",
        "React Three Fiber renders interactive 3D lot for precise spot reservation"
      ]
    },
    {
      "dot": "emerald",
      "title": "Stage 2: Authentication & Stripe Payment",
      "items": [
        "CreateBooking mutation sends authenticated JWT with Customer claim",
        "NestJS backend invokes Stripe Checkout API to generate session",
        "Driver is redirected to secure Stripe checkout for payment confirmation"
      ]
    },
    {
      "dot": "violet",
      "title": "Stage 3: Persistence & Valet Dispatch",
      "items": [
        "Stripe returns to /stripe/success webhook callback with session ID",
        "Prisma inserts Booking and initial BookingTimeline status into PostgreSQL",
        "Valet assignment triggers real-time task update to apps/web-valet (:3003)"
      ]
    }
