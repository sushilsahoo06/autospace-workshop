  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Execution Path (1 → 2 → 3 → 4)",
      "items": [
        "1. Driver initiates reservation on apps/web (:3001) over HTTPS.",
        "2. Web Client sends mutation CreateBooking via Apollo Client to NestJS /graphql on :3000.",
        "3. GraphQL Resolver delegates to BookingsService which executes Prisma ORM client queries.",
        "4. Prisma executes ACID relational transactions directly into PostgreSQL 16 on port 5432."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries & Security Isolations",
      "items": [
        "Public Untrusted Zone: Drivers and browser clients access frontends via public internet.",
        "Frontend DMZ: Next.js edge nodes holding NextAuth JWT sessions and Mapbox tokens.",
        "Private Backend Layer: Isolated NestJS instance rejecting requests without valid signed JWTs.",
        "Persistence Tier: PostgreSQL database accessible strictly through Prisma ORM internal wire protocol."
      ]
    },
    {
      "dot": "violet",
      "title": "External SaaS Dependencies",
      "items": [
        "Google OAuth 2.0: Federated user identity verification and OpenID profile synchronization.",
        "Mapbox GL: Cloud geocoding, interactive vector tiles, and vehicle turn-by-turn routing.",
        "Stripe Gateway: Offloaded PCI-compliant payment checkout sessions and asynchronous webhook confirmation."
      ]
    },
    {
      "dot": "amber",
      "title": "Operations & Specialized Subsystems",
      "items": [
        "Staff Portals: Unified Next.js portals for Garage Managers (:3002), Valets (:3003), and Admins (:3004).",
        "3D Spatial Visualizer: Embedded Three.js & React Three Fiber (@autospace/3d) rendering realistic parking slot meshes.",
        "Stripe Webhook Controller: Direct REST listener on /stripe/success for asynchronous booking fulfillment."
      ]
    }
  ]
