      ]
    },
    {
      "dot": "emerald",
      "title": "Backend Application Tier",
      "items": [
        "NestJS modular backend orchestrating business domains",
        "Apollo Server GraphQL API with code-first schema generation (/graphql)",
        "Swagger REST API for webhook ingestion and checkout flows",
        "Role-based authentication using JWT tokens and bcrypt password hashing"
      ]
    },
    {
      "dot": "violet",
      "title": "Data & Third-Party Services",
      "items": [
        "PostgreSQL 16 database accessed via Prisma ORM client",
        "Docker Compose setup mapping local port 2010 to database container port 5432",
        "Stripe integration handling checkout sessions, charges, and payment webhooks",
        "Google OAuth 2.0 social authentication provider integration"
      ]
    }
